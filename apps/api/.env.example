# Run node apps/api/scripts/database/setup.mjs from the project root.
# It generates database credentials and secret keys in the ignored .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/valora_dev
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/valora_test
WEB_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
API_PORT=4000
APP_ENV=local
MAIL_ENCRYPTION_KEY=
MEDIA_SIGNING_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI features share the local 9router gateway and daily limits. Keep the actual key in .env.local.
AI_EXPLAINER_ENABLED=false
AI_BASE_URL=http://localhost:20128/v1
AI_MODEL=ag/gemini-3.8-flash-high
AI_API_KEY=
AI_USER_DAILY_LIMIT=20
AI_APP_DAILY_LIMIT=200
AI_TIMEOUT_MS=60000
AI_PHOTO_ANALYSIS_ENABLED=false
# Empty uses AI_MODEL; enable only after validating multimodal support.
AI_PHOTO_MODEL=

# Guided repair / maintenance. Existing sessions remain readable and closable when disabled.
REPAIR_TUTORIALS_ENABLED=false
AI_REPAIR_TUTORIAL_ENABLED=false
# Empty falls back to AI_PHOTO_MODEL, then AI_MODEL.
AI_REPAIR_TUTORIAL_MODEL=
# Emergency withdrawal list, e.g. sew-button@1,drawer-handle@1
REPAIR_TUTORIAL_WITHDRAWN_VERSIONS=
