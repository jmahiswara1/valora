# Jalankan node apps/api/scripts/database/setup.mjs dari folder utama project.
# Skrip membuat kredensial database dan kunci rahasia di .env.local yang diabaikan Git.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/valora_dev
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/valora_test
WEB_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
API_PORT=4000
APP_ENV=local
MAIL_ENCRYPTION_KEY=
MEDIA_SIGNING_KEY=
# Mode local menyimpan email verifikasi di .local/mail; produksi memerlukan smtp.
MAIL_TRANSPORT=local
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# Gunakan true untuk TLS langsung (biasanya port 465), atau false untuk STARTTLS wajib (biasanya port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Konfigurasi bersama untuk asisten melayang, AI Explainer, analisis foto, dan AI perawatan.
# Pilihan 1: Gemini langsung. Jika GEMINI_API_KEY terisi, konfigurasi Gemini diprioritaskan.
# GEMINI_MODEL opsional; nilai bawaan: gemini-2.5-flash. Jangan isi kunci asli di file ini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Pilihan 2: layanan dengan API kompatibel OpenAI. Kosongkan GEMINI_API_KEY untuk memakai konfigurasi ini.
AI_BASE_URL=http://localhost:20128/v1
AI_MODEL=ag/gemini-3.8-flash-high
AI_API_KEY=

# Pengaktifan fitur dan batas pemakaian bersama; asisten melayang mengikuti layanan AI yang dipilih.
AI_EXPLAINER_ENABLED=true
AI_USER_DAILY_LIMIT=20
AI_APP_DAILY_LIMIT=200
AI_TIMEOUT_MS=60000
AI_PHOTO_ANALYSIS_ENABLED=true
# Model khusus analisis foto bersifat opsional; kosongkan agar mengikuti model AI bersama.
AI_PHOTO_MODEL=

# Panduan perbaikan/perawatan. Saat dinonaktifkan, sesi lama tetap dapat dibaca dan ditutup.
REPAIR_TUTORIALS_ENABLED=true
AI_REPAIR_TUTORIAL_ENABLED=true
# Jika kosong, gunakan AI_PHOTO_MODEL; jika itu juga kosong, gunakan model AI bersama.
AI_REPAIR_TUTORIAL_MODEL=
# Daftar versi panduan yang ditarik darurat, misalnya sew-button@1,drawer-handle@1.
REPAIR_TUTORIAL_WITHDRAWN_VERSIONS=
