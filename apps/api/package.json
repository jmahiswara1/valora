{
  "name": "@valora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm run build && concurrently -k \"tsc -p tsconfig.json --watch\" \"node --watch dist/main.js\"",
    "build": "pnpm run db:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm run db:generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "pnpm run build && vitest run src/modules/assessments/engine.test.ts src/modules/assessments/explainer/provider.test.ts && node scripts/test.mjs",
    "demo:stage4": "pnpm run build && node scripts/demo/transactions.mjs",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "pnpm run build && prisma db seed",
    "db:studio": "prisma studio",
    "demo:stage5": "pnpm run build && node scripts/demo/operations.mjs",
    "demo:stage6": "pnpm run build && node scripts/demo/session.mjs",
    "demo:items": "pnpm run build && node scripts/demo/items.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@valora/contracts": "workspace:*",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sharp": "^0.34.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "prisma": "7.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
