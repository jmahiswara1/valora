# Dependencies and generated output
node_modules/
**/dist/
**/.next/
**/.next-*/
**/next-env.d.ts
**/coverage/
**/playwright-report/
**/test-results/
*.tsbuildinfo
/apps/api/src/generated/

# Local credentials, uploads, and demo data
/.local/
**/.env*
!**/.env.example

# Local tools and caches
/.graphify-*/
/%SystemDrive%/
__pycache__/
*.py[cod]
*.log
.DS_Store
Thumbs.db

# Keep the portable Graphify documentation only
/graphify-out/*
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/graph.html
!/graphify-out/graph.json

# Review screenshots remain local; reports and fixtures are tracked
/apps/web/.impeccable/review/**/*.png
